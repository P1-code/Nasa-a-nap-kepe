# NASA APOD hĂˇttĂ©rkĂ©p beĂˇllĂ­tĂˇsa PowerShellbĹ‘l

# API kulcs: prioritĂˇsban a kĂ¶rnyezeti vĂˇltozĂł
$apiKey = $env:NASA_API_KEY
if (-not $apiKey) { $apiKey = "DEMO_KEY" }
$apodUrl = "https://api.nasa.gov/planetary/apod?api_key=$apiKey"

# NaplĂłzĂˇs beĂˇllĂ­tĂˇsa (opcionĂˇlis fĂˇjlba)
# ĂllĂ­tsd APOD_LOG_DISABLE=1 kĂ¶rnyezeti vĂˇltozĂłt, ha nem szeretnĂ©d a fĂˇjlba Ă­rĂˇst.
$logDisabled = $false
if ($env:APOD_LOG_DISABLE -and $env:APOD_LOG_DISABLE -eq '1') { $logDisabled = $true }

# Konzol Ă©s kimeneti kĂłdolĂˇs beĂˇllĂ­tĂˇsa, hogy az Ă©kezetek megjelenjenek
try {
    # OpciĂł: chcp 65001 > $null  # ha szĂĽksĂ©ges, engedĂ©lyezheted az UTF-8 code page-t is
    [Console]::OutputEncoding = [System.Text.Encoding]::UTF8
    $OutputEncoding = [System.Text.Encoding]::UTF8
} catch {
    # Ha nem megy, ne ĂˇllĂ­tsa meg a scriptet
}

# NaplĂłzĂˇsi kĂ¶nyvtĂˇr: preferĂˇljuk a OneDrive Pictures-t, majd a helyi Pictures-t
$oneDrivePics = Join-Path $env:USERPROFILE "OneDrive\Pictures"
$localPics = Join-Path $env:USERPROFILE "Pictures"
if (Test-Path $oneDrivePics) { $logDir = $oneDrivePics } elseif (Test-Path $localPics) { $logDir = $localPics } else {
    try { New-Item -Path $localPics -ItemType Directory -Force | Out-Null; $logDir = $localPics } catch { $logDir = $null }
}

if (-not $logDisabled -and $logDir) { $logPath = Join-Path $logDir "apod.log" } else { $logPath = $null }

function Write-Log {
    param(
        [string]$Message,
        [ValidateSet('INFO','WARN','ERROR')][string]$Level = 'INFO'
    )
    $ts = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
    $outLine = "[$ts] [$Level] $Message"


    if ($Level -eq 'ERROR') { Write-Error $outLine } else { Write-Host $outLine }

    if (-not $logDisabled -and $logPath) {
        try {
            # ĂŤrjunk fĂˇjlba UTF-8 kĂłdolĂˇssal. A jobb kompatibilitĂˇs Ă©rdekĂ©ben Ăşj fĂˇjl lĂ©trehozĂˇsakor
            # BOM-mal Ă­runk (Notepad kompatibilitĂˇs), majd a tovĂˇbbi hozzĂˇtoldĂˇsoknĂˇl BOM nĂ©lkĂĽl fĹ±zĂĽnk hozzĂˇ.
            $encWithBOM = New-Object System.Text.UTF8Encoding $true
            $encNoBOM   = New-Object System.Text.UTF8Encoding $false
            if (-not (Test-Path $logPath)) {
                [System.IO.File]::WriteAllText($logPath, $outLine + [Environment]::NewLine, $encWithBOM)
            } else {
                [System.IO.File]::AppendAllText($logPath, $outLine + [Environment]::NewLine, $encNoBOM)
            }
        } catch {
            # Ne akadĂˇlyozzuk a futĂˇst a naplĂłhiba miatt; Ă­rjuk ki konzolra.
            $warnTs = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
            $warnLine = "[$warnTs] [WARN] Nem sikerĂĽlt naplĂłfĂˇjlba Ă­rni: $($_.Exception.Message)"
            Write-Host $warnLine
        }
    }
}

# SegĂ©dfĂĽggvĂ©ny: prĂłbĂˇlkozĂˇs ismĂ©tlĂ©ssel (retries + exponenciĂˇlis backoff)
function Invoke-Retry {
    param(
        [ScriptBlock]$ScriptBlock,
        [int]$MaxRetries = 3,
        [int]$DelaySeconds = 2
    )

    $attempt = 0
    while ($true) {
        try {
            return & $ScriptBlock
        } catch {
            $attempt++
            if ($attempt -ge $MaxRetries) {
                throw $_
            } else {
                $wait = [int]($DelaySeconds * [math]::Pow(2, $attempt - 1))
                Write-Log "PrĂłbĂˇlkozĂˇs $attempt sikertelen. ĂšjraprĂłbĂˇlkozĂˇs $wait mĂˇsodperc mĂşlva..." 'WARN'
                Start-Sleep -Seconds $wait
            }
        }
    }
}

Write-Log "LekĂ©rdezĂ©s indĂ­tĂˇsa: $apodUrl" 'INFO'

# APOD metaadatok lekĂ©rĂ©se (retry)
try {
    $apodData = Invoke-Retry -ScriptBlock { Invoke-RestMethod -Uri $apodUrl -ErrorAction Stop } -MaxRetries 3 -DelaySeconds 2
    Write-Log "APOD metaadatok sikeresen lekĂ©rve." 'INFO'
} catch {
    Write-Log "Nem sikerĂĽlt lekĂ©rni az APOD metaadatokat: $($_.Exception.Message)" 'ERROR'
    exit 1
}

# EllenĹ‘rizzĂĽk, hogy valĂłban kĂ©p-e (APOD nĂ©ha videĂł)
if ($apodData.media_type -and $apodData.media_type -ne 'image') {
    Write-Log "A mai APOD nem kĂ©p (media_type = $($apodData.media_type)). Nem ĂˇllĂ­tok be hĂˇttĂ©rkĂ©pet." 'INFO'
    if ($apodData.url) { Write-Log "URL: $($apodData.url)" 'INFO' }
    exit 0
}

# KĂ©p URL-je
$imageUrl = $apodData.hdurl
if (-not $imageUrl) { $imageUrl = $apodData.url }
if (-not $imageUrl) {
    Write-Log "Nincs elĂ©rhetĹ‘ kĂ©p URL az API vĂˇlaszban." 'ERROR'
    exit 1
}
Write-Log "KĂ©p URL: $imageUrl" 'INFO'

# LetĂ¶ltĂ©si hely: prĂłbĂˇljuk elĹ‘szĂ¶r a OneDrive Pictures mappĂˇt, ha nincs, fallback a helyi Pictures mappĂˇra
if (Test-Path $oneDrivePics) { $wallpaperDir = $oneDrivePics } elseif (Test-Path $localPics) { $wallpaperDir = $localPics } else { 
    # Ha egyik sem lĂ©tezik, lĂ©trehozzuk a helyi Pictures mappĂˇt
    try {
        New-Item -Path $localPics -ItemType Directory -Force | Out-Null
        $wallpaperDir = $localPics
    } catch {
        Write-Log "Nem sikerĂĽlt lĂ©trehozni a kĂ©pmentĂ©si kĂ¶nyvtĂˇrat: $($_.Exception.Message)" 'ERROR'
        exit 1
    }
}

$wallpaperPath = Join-Path $wallpaperDir "apod_wallpaper.jpg"
Write-Log "LetĂ¶ltĂ©si cĂ©l: $wallpaperPath" 'INFO'

# KĂ©p letĂ¶ltĂ©se (retry)
try {
    Invoke-Retry -ScriptBlock { Invoke-WebRequest -Uri $imageUrl -OutFile $wallpaperPath -ErrorAction Stop } -MaxRetries 4 -DelaySeconds 2
    Write-Log "KĂ©p letĂ¶ltve: $wallpaperPath" 'INFO'
} catch {
    Write-Log "Nem sikerĂĽlt letĂ¶lteni a kĂ©pet: $($_.Exception.Message)" 'ERROR'
    exit 1
}

# HĂˇttĂ©rkĂ©p beĂˇllĂ­tĂˇsa Windows alatt â€” megbĂ­zhatĂł OS ellenĹ‘rzĂ©s (tĂˇmogatja a Windows PowerShell 5.1-et Ă©s PowerShell Core-t)
$runningOnWindows = $false
try {
    if ($IsWindows -eq $true) { $runningOnWindows = $true }
} catch {
    # $IsWindows lehet, hogy nincs definiĂˇlva (pl. Windows PowerShell 5.1), ezĂ©rt a fallback-et hasznĂˇljuk
}

if (-not $runningOnWindows) {
    if ($env:OS -eq 'Windows_NT') { $runningOnWindows = $true }
    else {
        try {
            if ([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform([System.Runtime.InteropServices.OSPlatform]::Windows)) {
                $runningOnWindows = $true
            }
        } catch {
            # Ha ez sem mĹ±kĂ¶dik, marad false
        }
    }
}

if (-not $runningOnWindows) {
    Write-Log 'A hĂˇttĂ©rkĂ©p beĂˇllĂ­tĂˇsa csak Windows rendszeren tĂˇmogatott.' 'ERROR'
    exit 1
}

# Csak akkor definiĂˇljuk Ăşjra, ha a Wallpaper tĂ­pus mĂ©g nincs betĂ¶ltve
$wallpaperType = [AppDomain]::CurrentDomain.GetAssemblies() | ForEach-Object { $_.GetType('Wallpaper') } | Where-Object { $_ -ne $null } | Select-Object -First 1
if (-not $wallpaperType) {
    Add-Type -TypeDefinition @'
using System.Runtime.InteropServices;
public class Wallpaper {
    [DllImport("user32.dll", SetLastError = true)]
    public static extern bool SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni);
}
'@
} else {
    Write-Log 'Wallpaper tĂ­pus mĂˇr be van tĂ¶ltve â€” Add-Type kihagyva.' 'INFO'
}

$SPI_SETDESKWALLPAPER = 20
$SPIF_UPDATEINIFILE = 1
$SPIF_SENDWININICHANGE = 2

try {
    $result = [Wallpaper]::SystemParametersInfo($SPI_SETDESKWALLPAPER, 0, $wallpaperPath, $SPIF_UPDATEINIFILE -bor $SPIF_SENDWININICHANGE)
    if ($result) {
        Write-Log ('HĂˇttĂ©rkĂ©p sikeresen beĂˇllĂ­tva: ' + $wallpaperPath) 'INFO'
        exit 0
    } else {
        $err = [Runtime.InteropServices.Marshal]::GetLastWin32Error()
        Write-Log ('A SystemParametersInfo hĂ­vĂˇs sikertelen. Win32 hiba: ' + $err) 'ERROR'
        exit 1
    }
} catch {
    Write-Log ('Hiba tĂ¶rtĂ©nt a hĂˇttĂ©rkĂ©p beĂˇllĂ­tĂˇsa kĂ¶zben: ' + $_.Exception.Message) 'ERROR'
    exit 1
}
