<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.szekerestamas.apod</string>

    <!-- ProgramArguments: teljes útvonal a bash-hez és a scriptedhez -->
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/szekerestamas/Programok/apod.sh</string>
    </array>

    <!-- Indítás minden nap 07:00-kor -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <!-- Naplózás fájlokba (teljes elérési út) -->
    <key>StandardOutPath</key>
    <string>/Users/szekerestamas/Library/Logs/com.szekerestamas.apod.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/szekerestamas/Library/Logs/com.szekerestamas.apod.err.log</string>

    <!-- Fusson a bejelentkezéskor is (opcionális) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Ha szeretnéd, hogy csak egyszer fusson (pl. ha azonnal indítod), használd a KeepAlive kulcsot másként -->
  </dict>
</plist>
